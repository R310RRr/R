local function formatNumber(number)
    local negative = number < 0
    local absolute = math.abs(number)
    if absolute >= 1e15 then
        return (negative and "-" or "") .. string.format("%.2fQa", absolute / 1e15)
    elseif absolute >= 1e12 then
        return (negative and "-" or "") .. string.format("%.2fT", absolute / 1e12)
    elseif absolute >= 1e9 then
        return (negative and "-" or "") .. string.format("%.2fB", absolute / 1e9)
    elseif absolute >= 1e6 then
        return (negative and "-" or "") .. string.format("%.2fM", absolute / 1e6)
    elseif absolute >= 1e3 then
        return (negative and "-" or "") .. string.format("%.2fK", absolute / 1e3)
    else
        return (negative and "-" or "") .. string.format("%.2f", absolute)
    end
end

