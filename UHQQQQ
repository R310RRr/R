local autoEggsActive = true

local function getEggFromInventory()
    local player = game.Players.LocalPlayer

    for _, item in ipairs(player.Backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name == "Protein Egg" then
            return item
        end
    end

    return nil
end

local function getEggTimer()
    local player = game.Players.LocalPlayer
    local folder = player:FindFirstChild("BoostTimersFolder")

    if not folder then
        return nil
    end

    return folder:FindFirstChild("Protein Egg")
end

local function getTimerValue(timer)
    if not timer then
        return nil
    end

    if timer:IsA("ValueBase") then
        return tonumber(timer.Value)
    end

    if timer:IsA("TextLabel") or timer:IsA("TextButton") then
        return tonumber(timer.Text)
    end

    return tonumber(timer.Value)
end

local function eatProteinEgg()
    local player = game.Players.LocalPlayer
    local egg = getEggFromInventory()

    if not egg then
        return false
    end

    player:WaitForChild("muscleEvent"):FireServer("proteinEgg", egg)
    return true
end

task.spawn(function()
    while autoEggsActive do
        local timer = getEggTimer()

        if timer then
            local value = getTimerValue(timer)

            if value and value >= 1798 and value <= 1800 then
                if eatProteinEgg() then
                    task.wait(3)
                end
            else
                task.wait(0.1)
            end
        else
            if eatProteinEgg() then
                task.wait(1798)
            else
                task.wait(1)
            end
        end
    end
end)

