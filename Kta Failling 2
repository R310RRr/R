local function autoProteinEgg()
    while _G.auto_protein_egg do
        pcall(function()
            if hasProteinBuff() then
                return
            end
            
            local egg = LocalPlayer.Backpack:FindFirstChild("Protein Egg")
            if egg then
                local character = LocalPlayer.Character
                if character then
                    local humanoid = character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:EquipTool(egg)
                        task.wait(0.2)
                        
                        local equippedEgg = character:FindFirstChild("Protein Egg")
                        if equippedEgg then
                            local muscleEvent = LocalPlayer.muscleEvent
                            muscleEvent:FireServer("proteinEgg", equippedEgg)
                            task.wait(0.2)
                            humanoid:UnequipTools()
                        else
                            humanoid:UnequipTools()
                        end
                    end
                end
            end
        end)
        task.wait(1)
    end
end

