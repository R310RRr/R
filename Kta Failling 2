local function getStrengthThreshold()
    return 1000 + 5000 * game.Players.LocalPlayer.leaderstats.Rebirths.Value / 2
end

local function autoAll()
    while _G.auto_all do
        pcall(function()
            local threshold = getStrengthThreshold()
            local currentStrength = game.Players.LocalPlayer.leaderstats.Strength.Value
            local equippedPet = tostring(game.Players.LocalPlayer.equippedPets.pet1.Value)
            
            local petsFolder = game.Players.LocalPlayer.petsFolder
            local pets = petsFolder:GetChildren()
            
            for _, pet in ipairs(pets) do
                local petName = pet.Name
                local petType = tostring(game.Players.LocalPlayer.equippedPets.pet1.Value)
                
                if currentStrength < threshold and petType == "Tribal Overlord" and petName == "Swift Samurai" then
                    local equipPetEvent = game:GetService("ReplicatedStorage").rEvents.equipPetEvent
                    equipPetEvent:FireServer("unequipPet", pet)
                    equipPetEvent:FireServer("equipPet", pet)
                elseif currentStrength >= threshold and petType == "Swift Samurai" and petName == "Tribal Overlord" then
                    local equipPetEvent = game:GetService("ReplicatedStorage").rEvents.equipPetEvent
                    equipPetEvent:FireServer("unequipPet", pet)
                    equipPetEvent:FireServer("equipPet", pet)
                end
            end
            
            local currentPet = tostring(game.Players.LocalPlayer.equippedPets.pet1.Value)
            
            if currentPet == "Swift Samurai" then
                for i = 1, 15 do
                    local muscleEvent = game:GetService("Players").LocalPlayer.muscleEvent
                    muscleEvent:FireServer("rep")
                end
            end
            
            if currentPet == "Tribal Overlord" then
                local rebirthRemote = game:GetService("ReplicatedStorage").rEvents.rebirthRemote
                rebirthRemote:InvokeServer("rebirthRequest")
            end
        end)
        wait()
    end
end

