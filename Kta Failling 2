})

if LocalPlayer.leaderstats then
    local initialRebirths = LocalPlayer.leaderstats.Rebirths.Value
    local totalGained = 0
    local lastGain = 0
    local lastTime = nil
    local totalInterval = 0
    local totalAmount = 0
    local totalCount = 0
    local windowSize = 60
    local records = {}
    
    LocalPlayer.leaderstats.Rebirths:GetPropertyChangedSignal("Value"):Connect(function()
        local gained = LocalPlayer.leaderstats.Rebirths.Value - (initialRebirths + totalGained)
        if gained > 0 then
            totalGained = totalGained + gained
            local currentTime = os.clock()
            if lastTime then
                local interval = currentTime - lastTime
                if interval > 0.5 and interval < 600 then
                    table.insert(records, {
                        interval = interval,
                        amount = gained,
                        time = os.time()
                    })
                    totalInterval = totalInterval + interval
                    totalAmount = totalAmount + gained
                    totalCount = totalCount + 1
                end
            end
            lastTime = currentTime
            lastGain = gained
            
            for i = #records, 1, -1 do
                if os.clock() - records[i].time > windowSize then
                    local removed = table.remove(records, i)
                    if removed then
                        totalInterval = totalInterval - removed.interval
                        totalAmount = totalAmount - removed.amount
                        totalCount = totalCount - 1
                    end
                end
            end
        end
    end)
    
    task.spawn(function()
        while true do
            task.wait(1.2)
            pcall(function()
                local rebirths = LocalPlayer.leaderstats.Rebirths.Value
                local avgInterval = totalCount > 0 and totalInterval / totalCount or 0
                local avgAmount = totalCount > 0 and totalAmount / totalCount or 0
                local perHour = avgInterval > 0 and (3600 / avgInterval) * avgAmount or 0
                
                local intervalText = totalCount > 0 and formatNumber(avgInterval, 1) .. "s" or "等待数据"
                local perHourText = perHour > 0 and abbreviateNumber(perHour) or "等待数据"
                
                statsParagraph:SetDesc(
                    "总重生: " .. abbreviateNumber(rebirths) .. "\n" ..
                    "已获得: " .. abbreviateNumber(totalGained) .. "\n" ..
                    "重生/时: " .. perHourText .. "\n" ..
                    "重生/天: " .. abbreviateNumber(perHour * 24)
                )
            end)
        end
    end)
else
    statsParagraph:SetDesc("数据加载失败，请重新运行脚本")
end

