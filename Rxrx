local ExtraSection = ExtraTab:AddSection("Pack Spam & Pets", "Pet Features")

local running = false

local function getRemote()
    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    if not rEvents then return end
    return rEvents:FindFirstChild("equipPetEvent")
end

local function unequipAll(remote, petsFolder)
    for _, folder in pairs(petsFolder:GetChildren()) do
        if folder:IsA("Folder") then
            for _, pet in pairs(folder:GetChildren()) do
                remote:FireServer("unequipPet", pet)
            end
        end
    end
end

local function getPets(folder, name)
    local t = {}
    for _, pet in pairs(folder:GetChildren()) do
        if pet.Name == name then
            table.insert(t, pet)
        end
    end
    return t
end

ExtraSection:AddButton("Start Pack Spam", function()
