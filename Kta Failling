task.spawn(function()
    local initialStrength = nil
    local initialDurability = nil
    local startTime = os.clock()
    local lastStrengthGain = 0
    local lastDurabilityGain = 0
    local strengthPerSec = 0
    local durabilityPerSec = 0
    
    while true do
        task.wait(0.5)
        pcall(function()
            if LocalPlayer.leaderstats and LocalPlayer.leaderstats.Strength and LocalPlayer.Durability then
                local strength = LocalPlayer.leaderstats.Strength.Value
                local durability = LocalPlayer.Durability.Value
                
                if initialStrength == nil then
                    initialStrength = strength
                    initialDurability = durability
                    startTime = os.clock()
                end
                
                local strengthGain = strength - initialStrength
                local durabilityGain = durability - initialDurability
                local currentTime = os.clock()
                local elapsedTime = currentTime - startTime
                
                if elapsedTime > 0 then
                    strengthPerSec = (strengthGain - lastStrengthGain) / elapsedTime
                    durabilityPerSec = (durabilityGain - lastDurabilityGain) / elapsedTime
                end
                
                lastStrengthGain = strengthGain
                lastDurabilityGain = durabilityGain
                startTime = currentTime
                
                statsParagraph:SetDesc(
                    "总力量: " .. abbreviateNumber(strength) .. "\n" ..
                    "总耐力: " .. abbreviateNumber(durability) .. "\n" ..
                    "已获得力量: " .. abbreviateNumber(strengthGain) .. "\n" ..
                    "已获得耐力: " .. abbreviateNumber(durabilityGain) .. "\n" ..
                    "力量/秒: " .. abbreviateNumber(strengthPerSec) .. "\n" ..
                    "耐力/秒: " .. abbreviateNumber(durabilityPerSec) .. "\n" ..
                    "力量/天: " .. abbreviateNumber(strengthPerSec * 86400) .. "\n" ..
                    "耐力/天: " .. abbreviateNumber(durabilityPerSec * 86400)
                )
            end
        end)
    end
end)

