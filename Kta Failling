local function getAvailableFoods()
    local backpack = LocalPlayer.Backpack
    local available = {}
    
    for _, foodName in ipairs(foodList) do
        if backpack:FindFirstChild(foodData[foodName].toolName) then
            table.insert(available, foodName)
        end
    end
    
    return available
end

local function equipFood(food)
    if not food then
        return false
    end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end
    
    local currentTool = character:FindFirstChildOfClass("Tool")
    if currentTool and currentTool.Name == food.toolName then
        return true
    end
    
    local backpack = LocalPlayer.Backpack
    local tool = backpack:FindFirstChild(food.toolName)
    
    if tool then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then
                humanoid:UnequipTools()
            end
        end
        
        task.wait(0.1)
        humanoid:EquipTool(tool)
        task.wait(0.2)
        
        local equippedTool = character:FindFirstChildOfClass("Tool")
        if equippedTool and equippedTool.Name == food.toolName then
            return true
        end
    end
    
    return false
end

local function checkFoodStillExists(food)
    local backpack = LocalPlayer.Backpack
    return backpack:FindFirstChild(food.toolName) ~= nil
end

local function formatNumber(num)
    return string.format("%.2f", num)
end

local suffixes = {"", "K", "M", "B", "T", "Qa", "Qi"}

local function abbreviateNumber(num)
    if num == nil then
        return "0"
    end
    
    local absNum = math.abs(num)
    if absNum < 1000 then
        return formatNumber(num)
    end
    
    local tier = math.floor(math.log10(absNum) / 3)
    return formatNumber(num / 1000^tier) .. (suffixes[tier + 1] or "e" .. tier * 3)
end

local function cleanOtherUIs()
    local suspiciousKeywords = {
        "+", "Coin", "Strength", "Exp", "Experience", "Level", "Health"
    }
    
    local suspiciousUINames = {
        "MobileWindUI", "Crazy Top", "Rayfield", "KJY_Team_AntiDup"
    }
    
    local function checkAndDestroy(parent)
        pcall(function()
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("ScreenGui") then
                    for _, uiName in ipairs(suspiciousUINames) do
                        if child.Name:find(uiName) then
                            child:Destroy()
                            break
                        end
                    end
                end
                
                for _, descendant in ipairs(child:GetDescendants()) do
                    if (descendant:IsA("TextLabel") or descendant:IsA("TextButton")) and descendant.Text then
                        for _, keyword in ipairs(suspiciousKeywords) do
                            if descendant.Text:find(keyword) then
                                child:Destroy()
                                break
                            end
                        end
                    end
                end
            end
        end)
    end
    
    checkAndDestroy(game:GetService("CoreGui"))
    
    if LocalPlayer:FindFirstChild("PlayerGui") then
        checkAndDestroy(LocalPlayer.PlayerGui)
    end
    
    pcall(function()
        if not _G.originalBrightness then
            _G.originalBrightness = Lighting.Brightness
        end
        Lighting.Brightness = 0
        Lighting.ClockTime = 0
        Lighting.FogEnd = 0
        Lighting.GlobalShadows = false
    end)
end

