local function hasProteinBuff()
    local boostTimersFolder = LocalPlayer:FindFirstChild("boostTimersFolder")
    if boostTimersFolder then
        return boostTimersFolder:FindFirstChild("Protein Egg") ~= nil
    end
    return false
end

local function autoTrain()
    while _G.auto_train do
        pcall(function()
            local muscleEvent = LocalPlayer.muscleEvent
            if muscleEvent then
                for i = 0, 19 do
                    muscleEvent:FireServer("rep")
                end
            end
        end)
        task.wait(0.02)
    end
end

local function autoProteinEgg()
    while _G.auto_protein do
        task.wait(1)
        pcall(function()
            if not hasProteinBuff() then
                local egg = LocalPlayer.Backpack:FindFirstChild("Protein Egg")
                if egg then
                    local character = LocalPlayer.Character
                    if character then
                        local humanoid = character:FindFirstChild("Humanoid")
                        if humanoid then
                            humanoid:EquipTool(egg)
                            task.wait(0.2)
                            
                            local equippedEgg = character:FindFirstChild("Protein Egg")
                            if equippedEgg then
                                local muscleEvent = LocalPlayer.muscleEvent
                                muscleEvent:FireServer("proteinEgg", equippedEgg)
                                print("Protein egg used (buff was missing)")
                            end
                            
                            task.wait(0.2)
                            humanoid:UnequipTools()
                        end
                    end
                else
                    if _G.auto_protein then
                        print("No protein egg in backpack")
                    end
                end
            else
                if _G.auto_protein then
                    print("Protein buff active, waiting...")
                end
            end
        end)
    end
end

local function autoEatShakes()
    while _G.auto_eat_shake do
        if currentFoodIndex > #foodList then
            currentFoodIndex = 1
            task.wait(0.5)
        end
        
        local food = foodData[foodList[currentFoodIndex]]
        
        if checkFoodStillExists(food) then
            if equipFood(food) then
                task.wait(0.5)
                VirtualUser:Button1Down(Vector2.new(10, 10), workspace.CurrentCamera.CFrame)
                task.wait(0.05)
                VirtualUser:Button1Up(Vector2.new(10, 10), workspace.CurrentCamera.CFrame)
            end
            task.wait(0.1)
        else
            currentFoodIndex = currentFoodIndex + 1
            task.wait(0.2)
        end
    end
end

